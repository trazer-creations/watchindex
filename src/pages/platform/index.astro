---
import Base from '../../layouts/Base.astro';
import { getPlatforms, getPlatformStats, getChart, getLatestDate } from '../../lib/db';
import { formatDate, platformLabel } from '../../lib/format';

const platforms = getPlatforms();
const stats = getPlatformStats();
const latest = getLatestDate();
const byPlatform = new Map(stats.map((s) => [s.platform, s]));
const topOnes = new Map(
  platforms.map((p) => {
    const movies = getChart(p, 'movie', latest);
    const tv = getChart(p, 'tv', latest);
    return [p, { movie: movies[0], tv: tv[0] }];
  }),
);
---
<Base title="All platforms" description="Every streaming platform tracked, with latest Top 10 charts.">
  <p class="text-sm uppercase tracking-wide text-slate-500">Latest charts · {formatDate(latest)}</p>
  <h1 class="mt-1 text-3xl font-bold tracking-tight">All platforms</h1>
  <p class="mt-2 text-sm text-slate-600">{platforms.length} platforms tracked.</p>
  <ul class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
    {platforms.map((p) => {
      const s = byPlatform.get(p);
      const top = topOnes.get(p);
      return (
        <li>
          <a href={`/platform/${p}/`} class="block rounded-xl border border-slate-200 bg-white p-4 hover:border-slate-400">
            <span class="text-lg font-semibold">{platformLabel(p)}</span>
            <span class="mt-1 block text-xs text-slate-500">
              {s?.dates ?? 0} day{(s?.dates ?? 0) === 1 ? '' : 's'} · {s?.entries ?? 0} entries
            </span>
            <span class="mt-3 block space-y-1 text-sm">
              <span class="block truncate"><span class="font-bold text-slate-400">#1 🎬 </span>{top?.movie?.title ?? '—'}</span>
              <span class="block truncate"><span class="font-bold text-slate-400">#1 📺 </span>{top?.tv?.title ?? '—'}</span>
            </span>
          </a>
        </li>
      );
    })}
  </ul>
</Base>
