---
import Base from '../../layouts/Base.astro';
import RankSparkline from '../../components/RankSparkline.astro';
import { getPlatforms, getTitle, getTitleHistory, summarizeHistory } from '../../lib/db';
import { formatDate, platformLabel } from '../../lib/format';

export async function getStaticPaths() {
  // 383 slugs today; Astro pre-renders one page each at build time.
  const { getAllTitleSlugs } = await import('../../lib/db');
  return getAllTitleSlugs().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const platforms = getPlatforms();
const title = getTitle(slug);
if (!title) throw new Error(`Title not found: ${slug}`);
const history = getTitleHistory(slug);
const summary = summarizeHistory(history);
const ascending = [...history].reverse();
---
<Base title={`${title.title} — rank history`} platforms={platforms}>
  <p class="text-sm text-slate-500"><a href="/title/" class="underline">Titles</a> / {title.title}</p>
  <h1 class="mt-1 text-3xl font-bold tracking-tight">{title.title}</h1>
  <p class="mt-2 text-sm text-slate-600">
    First seen {formatDate(title.first_seen)} ·
    {summary.types.length > 0 ? ` ${summary.types.join(' + ')} ·` : ''} best #{summary.bestRank} ·
    {summary.days} day{summary.days === 1 ? '' : 's'} in Top 10 across {summary.platforms} platform{summary.platforms === 1 ? '' : 's'} ·
    <a class="underline" href={title.url} rel="external">FlixPatrol ↗</a>
  </p>

  <div class="mt-6 grid gap-6 lg:grid-cols-3">
    <div class="grid grid-cols-2 gap-3 lg:col-span-1">
      <div class="rounded-lg border border-slate-200 bg-white p-4"><p class="text-xs uppercase text-slate-500">Best rank</p><p class="text-2xl font-bold">#{summary.bestRank}</p></div>
      <div class="rounded-lg border border-slate-200 bg-white p-4"><p class="text-xs uppercase text-slate-500">Days in Top 10</p><p class="text-2xl font-bold">{summary.days}</p></div>
      <div class="rounded-lg border border-slate-200 bg-white p-4"><p class="text-xs uppercase text-slate-500">Platforms</p><p class="text-2xl font-bold">{summary.platforms}</p></div>
      <div class="rounded-lg border border-slate-200 bg-white p-4"><p class="text-xs uppercase text-slate-500">Latest</p><p class="text-2xl font-bold">{summary.latest ? `#${summary.latest.rank}` : '—'}</p><p class="text-xs text-slate-500">{summary.latest ? `${platformLabel(summary.latest.platform)} · ${summary.latest.date}` : ''}</p></div>
    </div>
    <div class="lg:col-span-2">
      <h2 class="mb-2 text-sm font-semibold uppercase tracking-wide text-slate-500">Rank over time</h2>
      <RankSparkline rows={ascending} />
    </div>
  </div>

  <h2 class="mb-2 mt-8 text-sm font-semibold uppercase tracking-wide text-slate-500">History</h2>
  <div class="overflow-hidden rounded-lg border border-slate-200 bg-white">
    <table class="w-full text-sm">
      <thead class="bg-slate-100 text-left text-xs uppercase text-slate-500">
        <tr><th class="px-4 py-2">Date</th><th class="px-4 py-2">Platform</th><th class="px-4 py-2">Type</th><th class="px-4 py-2">Rank</th><th class="px-4 py-2">Points</th></tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        {history.map((h) => (
          <tr>
            <td class="px-4 py-2"><a class="underline" href={`/platform/${h.platform}/${h.date}/`}>{h.date}</a></td>
            <td class="px-4 py-2"><a class="underline" href={`/platform/${h.platform}/`}>{platformLabel(h.platform)}</a></td>
            <td class="px-4 py-2">{h.content_type}</td>
            <td class="px-4 py-2 font-bold">#{h.rank}</td>
            <td class="px-4 py-2 tabular-nums">{h.points ?? '—'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Base>
