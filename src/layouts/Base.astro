---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  platforms?: string[];
  currentPlatform?: string;
}

const { title, description } = Astro.props;
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href);
const linkClass = (href: string) =>
  ['rounded px-2 py-1 hover:bg-slate-100', isActive(href) ? 'bg-slate-900 text-white hover:bg-slate-900' : ''].join(' ');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description ?? 'Daily FlixPatrol Top 10 streaming charts by platform.'} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900 antialiased">
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-4">
        <a href="/" class="text-lg font-bold tracking-tight">FlixPatrol Top 10</a>
        <nav class="flex flex-wrap items-center gap-1 text-sm">
          <a href="/" class={linkClass('/')}>Home</a>
          <a href="/title/" class={linkClass('/title/')}>Titles</a>
          <a href="/platform/" class={linkClass('/platform/')}>Platforms</a>
        </nav>
      </div>
    </header>
    <main class="mx-auto max-w-6xl px-4 py-8">
      <slot />
    </main>
    <footer class="border-t border-slate-200 bg-white">
      <div class="mx-auto max-w-6xl px-4 py-6 text-sm text-slate-500">
        Data scraped from <a class="underline" href="https://flixpatrol.com">FlixPatrol</a> · rebuilt daily from SQLite at build time.
      </div>
    </footer>
  </body>
</html>
